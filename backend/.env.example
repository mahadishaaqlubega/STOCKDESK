PORT=4000
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=stockdesk
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
# Managed providers (Railway) use cert chains Node doesn't trust by default.
# Leave unset/empty to accept them; set to "true" to enforce strict validation.
# DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=30m
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_PATTERNS=https://*.vercel.app
FRONTEND_URL=http://localhost:5173
# Email provider — verification and password reset links use FRONTEND_URL, not this variable
# For local development: leave EMAIL_PROVIDER empty and the system will auto-detect based on credentials
# For production with Resend: set EMAIL_PROVIDER=resend and provide RESEND_API_KEY + RESEND_FROM_EMAIL
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# For Resend: use a verified sender domain or email. Avoid onboarding@resend.dev in production.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=StockDesk
# For SMTP fallback: uncomment and configure these values
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=StockDesk
# SuperAdmin account (optional) — created on first boot if configured
SUPERADMIN_NAME=Platform Administrator
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
